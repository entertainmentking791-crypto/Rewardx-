rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Boot connectivity check document
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'avatarId', 'level', 'xp', 'coins', 'joinedDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'name', 'avatarId', 'level', 'xp', 'coins', 'joinedDate',
          'unlockedAvatars', 'claimedBadges', 'claimedRewardIds',
          'highScores', 'recentGames', 'dailyBonus', 'adTasks',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.avatarId is string && data.avatarId.size() >= 1 && data.avatarId.size() <= 32
        && data.level is int && data.level >= 1 && data.level <= 1000
        && data.xp is int && data.xp >= 0
        && data.coins is int && data.coins >= 0
        && data.joinedDate is string && data.joinedDate.size() >= 1 && data.joinedDate.size() <= 32
        && (!('unlockedAvatars' in data) || (data.unlockedAvatars is list && data.unlockedAvatars.size() <= 16 && (data.unlockedAvatars.size() == 0 || data.unlockedAvatars[0] is string)))
        && (!('claimedBadges' in data) || (data.claimedBadges is list && data.claimedBadges.size() <= 16 && (data.claimedBadges.size() == 0 || data.claimedBadges[0] is string)))
        && (!('claimedRewardIds' in data) || (data.claimedRewardIds is list && data.claimedRewardIds.size() <= 64 && (data.claimedRewardIds.size() == 0 || data.claimedRewardIds[0] is string)))
        && (!('highScores' in data) || data.highScores is map)
        && (!('recentGames' in data) || (data.recentGames is list && data.recentGames.size() <= 10 && (data.recentGames.size() == 0 || data.recentGames[0] is string)))
        && (!('dailyBonus' in data) || data.dailyBonus is map)
        && (!('adTasks' in data) || data.adTasks is map);
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'photoURL', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidTransaction(data, userId, txId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'amount', 'type', 'date', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'amount', 'type', 'date', 'gameId', 'status', 'createdAt'])
        && data.id is string && data.id == txId && data.id.size() <= 64
        && data.userId is string && data.userId == request.auth.uid && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.amount is int
        && data.type in ['EARN_GAME', 'DAILY_BONUS', 'REDEEM_REWARD', 'ACHIEVEMENT', 'REWARDED_AD']
        && data.date is string && data.date.size() >= 1 && data.date.size() <= 40
        && (!('gameId' in data) || (data.gameId is string && data.gameId.size() <= 64))
        && data.status in ['COMPLETED', 'PROCESSING', 'PENDING'];
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().joinedDate == existing().joinedDate
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'avatarId', 'level', 'xp', 'coins',
          'unlockedAvatars', 'claimedBadges', 'claimedRewardIds',
          'highScores', 'recentGames', 'dailyBonus', 'adTasks',
          'updatedAt'
        ]);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && docId == 'info'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && docId == 'info'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'photoURL', 'updatedAt']);
        allow delete: if false;
      }

      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(txId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidTransaction(incoming(), userId, txId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
